# Supabase server configuration
SUPABASE_URL=
# Preferred for new Supabase projects; keep the legacy service role below if that is what your project uses.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public Supabase variables (only needed if browser-side Supabase access is added later)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin credentials - never commit real values
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Use a random secret with at least 32 characters
ADMIN_SESSION_SECRET=

# Scheduled reservation reminder endpoint
# Use a long random secret and add the same value to the Vercel production environment.
CRON_SECRET=

# Public app URL used in email links when available
NEXT_PUBLIC_APP_URL=

# SMTP / Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ELYON BARBER <your-gmail-address@example.com>"

# Optional barber notification recipient
BARBER_NOTIFICATION_EMAIL=

# Optional Google Maps embed URL
GOOGLE_MAPS_EMBED_URL=
